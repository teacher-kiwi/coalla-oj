# 저장소 전체에서 이 파일 하나만 쓴다.
# 하위 디렉터리(backend/, frontend/, judge/)에 있던 .gitignore 는 상위 오픈소스에서
# 딸려온 것이라 여기로 합쳤다.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
.python-version
venv/

# Django
backend/static/
backend/media/
backend/dist/
backend/.env
backend/custom_settings.py

# 백엔드 런타임 산출물. 컨테이너가 채우는 자리라 디렉터리만 남긴다.
# 기본 아바타와 파비콘은 기동할 때 여기서 복사해가므로 반드시 추적해야 한다
# (backend/deploy/entrypoint.sh).
backend/data/log/*
!backend/data/log/.gitkeep
backend/data/test_case/*
!backend/data/test_case/.gitkeep
backend/data/ssl/*
!backend/data/ssl/.gitkeep
backend/data/config/*
!backend/data/config/.gitkeep
backend/data/public/upload/*
!backend/data/public/upload/.gitkeep
backend/data/public/avatar/*
!backend/data/public/avatar/default.png

# docker compose 가 읽는 환경변수 파일 (실제 비밀값)
.env
# docker compose 볼륨이 쌓이는 곳. 앞의 / 가 없으면 backend/data 까지 걸린다.
/data/

# Vue / Node
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.DS_Store
frontend/.eslintcache
# package-lock.json 은 추적한다. CI 가 npm ci 로 같은 의존성을 설치해야 한다.
frontend/yarn.lock

# Docker
*.pid
*.log
docker-compose.override.yml
**/.docker-cache/

# macOS
.DS_Store

# IDE / Editor
.vscode/
.idea/
*.iml
*.swp
*.swo

# Build artifacts
dist/
build/
tmp/
cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pytest / coverage
.cache/
.coverage
htmlcov/

# Others
*.zip
*.tar
*.tar.gz
