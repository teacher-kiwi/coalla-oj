# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
#   cp .env.example .env
#
# .env 는 git 에 올라가지 않습니다(.gitignore). docker compose 가 자동으로 읽습니다.
#
# [필수] 아래 세 개는 반드시 채워야 합니다. 비어 있으면 컨테이너가 기동하지 않고
#        어떤 값이 없는지 알려줍니다.
# [선택] 나머지는 비워두면 주석에 적힌 기본값이 적용됩니다.


# ============================================================
# [필수] 비밀값
# ============================================================

# 데이터베이스 비밀번호. 운영에서는 충분히 긴 임의 문자열을 쓰세요.
# 주의: 이미 만들어진 DB 볼륨이 있다면 그때 쓴 값과 같아야 접속됩니다.
POSTGRES_PASSWORD=

# 채점 서버 인증 토큰. backend 와 judge 가 같은 값을 공유해야 합니다.
#   생성 예: openssl rand -hex 32
JUDGE_SERVER_TOKEN=

# 최초 기동 시 만들어지는 root 계정의 비밀번호.
# 구글 로그인을 쓰더라도 root 는 유일한 비상 접속 경로이므로 강한 값으로 두세요.
# 계정이 이미 만들어진 뒤에는 이 값을 바꿔도 반영되지 않습니다(관리자 화면에서 변경).
ADMIN_PASSWORD=


# ============================================================
# [선택] 데이터베이스 이름 / 계정
# ============================================================
# 기본값: onlinejudge
POSTGRES_DB=
POSTGRES_USER=


# ============================================================
# [선택] 공개 포트
# ============================================================
# 이미 80/8000 번을 쓰는 서버라면 여기서 바꾸세요.
# 기본값: FRONTEND_PORT=80, BACKEND_PORT=8000
FRONTEND_PORT=
BACKEND_PORT=

# 개발용(docker-compose.dev.yml)에서 vite 개발 서버가 열리는 포트
# 기본값: 8080
FRONTEND_DEV_PORT=


# ============================================================
# [선택] 데이터 저장 경로
# ============================================================
# 테스트 케이스·업로드 파일·DB 가 저장되는 호스트 경로.
# 별도 디스크에 두려면 절대 경로를 지정하세요. 기본값: ./data
DATA_DIR=


# ============================================================
# [선택] 프론트엔드 빌드 값
# ============================================================
# 화면 하단(푸터)에 표시되는 버전 문자열. 기본값: coalla-oj
# 운영 빌드에서는 compose 가 빌드 인자로, 개발에서는 환경변수로 전달합니다.
VITE_VERSION=




# ============================================================
# 참고 — 아래 값들은 .env 가 아니라 관리자 화면(시스템 설정)에서 설정합니다.
# 운영 중에 바뀔 수 있고, DB 에 저장되어 인스턴스마다 다르기 때문입니다.
#   - 사이트 이름 / 기본 URL / 푸터
#   - 회원가입 허용 여부
#   - 구글 로그인 클라이언트 ID  (비밀이 아니며 브라우저에 노출되는 값입니다)
#   - 나이스 학교정보 API 키
# ============================================================
